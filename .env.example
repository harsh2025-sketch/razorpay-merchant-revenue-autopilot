APP_ENV=development
DATABASE_URL=sqlite:///./data/autopilot.db
CORS_ALLOWED_ORIGINS=http://localhost:3000
# OpenAI-compatible LLM boundary. Leave OPENAI_BASE_URL unset for OpenAI.
# For OpenRouter use: https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Razorpay execution is real by default. Hosted demos without merchant KYC may
# set this to simulated; simulated mode performs no Razorpay HTTP requests and
# creates clearly-labelled demo_plink_... resources only.
RAZORPAY_EXECUTION_MODE=real
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_OFFER_ID=
