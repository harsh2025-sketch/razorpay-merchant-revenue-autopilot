# Public base URL of the Merchant Revenue Autopilot API as seen by the browser.
# Local development: FastAPI on port 8000.
# Production: the deployed Render HTTPS origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Absolute API URL used by server-side rendering. Use the same Render HTTPS
# origin in production. This is not a secret.
API_INTERNAL_BASE_URL=http://localhost:8000
